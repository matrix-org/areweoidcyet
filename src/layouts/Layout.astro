---
import "./main.css";
interface Props {
    title: string;
}

const { title } = Astro.props;

const commitSha = __COMMIT_SHA__;
const commitUrl =
    commitSha && `https://github.com/matrix-org/areweoidcyet/commit/${commitSha}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Astro description" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <main>
            <slot />
        </main>
        <footer>
            {
                commitSha ? (
                    <span>
                        Built from{" "}
                        <a href={commitUrl}>
                            <code>{commitSha.slice(0, 7)}</code>
                        </a>{" "}
                        &middot;{" "}
                        <a href="https://github.com/matrix-org/areweoidcyet">
                            Source on GitHub
                        </a>
                    </span>
                ) : (
                    <a href="https://github.com/matrix-org/areweoidcyet">
                        Source on GitHub
                    </a>
                )
            }
        </footer>
    </body>
</html>
